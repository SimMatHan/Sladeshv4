  "annotations": [
    { "id": "raekke1", "x": 0, "y": -150, "w": 880, "text": "Retning A koert ud paa alle skaerme. Oeverste raekke er de fire, man rammer oftest; nederste er Kanalens tre faner plus Admin. Palet-arket til hoejre har de forbehold, der skal ryddes af vejen foer paletten kan skrives ind i index.css.", "page": "page-1" },
    { "id": "arknote", "x": 980, "y": -150, "w": 880, "text": "Log-arket, Trofaehylden og Admin er ARK — de ligger over den skaerm, man stod paa, og lukkes ved tryk ved siden af. Derfor dugen bagved.", "page": "page-1" },
    { "id": "fravalgt", "x": 0, "y": -150, "w": 880, "text": "Ikke valgt. Staar her som optegnelse over, hvad der blev overvejet — se palet-arket for bagsiden ved hver.", "page": "page-2" },
    { "id": "moerknote", "x": 0, "y": -150, "w": 880, "text": "Moerk er fortsat appens udgangspunkt; retning A er det LYSE tema. De fem strukturelle greb til hoejre gaelder begge temaer.", "page": "page-3" }
  ],
