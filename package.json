{
  "name": "sladeshv4",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "convex dev --start 'vite'",
    "dev:frontend": "vite",
    "dev:backend": "convex dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p convex/tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "oxlint",
    "test:logic": "esbuild scripts/logic-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/logic-test.mjs --log-level=error && node node_modules/.tmp/logic-test.mjs",
    "smoke-test": "node --experimental-strip-types --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/smoke-test.ts",
    "datarevision": "node --experimental-strip-types --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/datarevision.ts",
    "migrer": "node --experimental-strip-types --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrer.ts",
    "katalog": "node --experimental-strip-types --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/katalog.ts"
  },
  "dependencies": {
    "convex": "^1.43.0",
    "firebase": "^12.17.1",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.28.2",
    "firebase-admin": "^14.2.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
