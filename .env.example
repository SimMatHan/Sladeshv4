# ---------------------------------------------------------------------------
# Convex — skrives automatisk af `npx convex dev` til .env.local.
# Commit ALDRIG .env.local.
# ---------------------------------------------------------------------------
VITE_CONVEX_URL=https://<dit-deployment>.convex.cloud
CONVEX_DEPLOYMENT=dev:<dit-deployment>

# ---------------------------------------------------------------------------
# Firebase — KUN Authentication. Firestore bruges ikke i dette projekt.
# Disse værdier er ikke hemmeligheder: Firebase-web-nøgler er offentlige
# identifikatorer, der udleveres i klient-bundlet. Adgang styres af
# Firebase-reglerne, ikke af nøglen.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyCiGBvWbUZMe7Qj7IiHUSEwSYgHNRHBu9k
VITE_FIREBASE_AUTH_DOMAIN=sladeshultimate-1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sladeshultimate-1
VITE_FIREBASE_STORAGE_BUCKET=sladeshultimate-1.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=244803134905
VITE_FIREBASE_APP_ID=1:244803134905:web:414bf0a6f191d6af62c268

# Offentlig VAPID-nøgle til web push (kommer i brug i en senere fase).
VITE_VAPID_PUBLIC_KEY=BAj3IaZFbVXbsfS3klQBM4e7HBpzsFCmWBg9QBaBU6_bbYu_Yp2S8gYuxotP3sVt7O4xOpx6uUnFWrDw_YqYaqA

# ---------------------------------------------------------------------------
# VIGTIGT: Convex-deploymentet læser IKKE denne fil.
# convex/auth.config.ts kører på serveren og skal have projekt-id'et sat
# separat, ellers afvises alle tokens:
#
#   npx convex env set VITE_FIREBASE_PROJECT_ID <dit-firebase-projekt-id>
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Smoke-test — INTET er påkrævet her.
#
# `npm run smoke-test` bruger som standard to faste testkonti og opretter dem
# selv i Firebase Auth første gang:
#
#   smoke-test+a@sladeshapp.dk
#   smoke-test+b@sladeshapp.dk
#
# Sæt kun nedenstående hvis du vil bruge andre konti. Emailen SKAL starte med
# "smoke-test+", ellers nægter oprydningen at slette noget.
# ---------------------------------------------------------------------------
# SMOKE_TEST_EMAIL=
# SMOKE_TEST_PASSWORD=
# SMOKE_TEST_EMAIL_2=
# SMOKE_TEST_PASSWORD_2=
