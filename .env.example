# Skrives automatisk af `npx convex dev` til .env.local — commit ALDRIG .env.local.
# Denne fil viser blot hvilke variabler projektet forventer.

# URL til Convex-deploymentet, som frontenden forbinder til.
VITE_CONVEX_URL=https://<dit-deployment>.convex.cloud

# Sættes af Convex CLI; identificerer deploymentet lokalt.
CONVEX_DEPLOYMENT=dev:<dit-deployment>
